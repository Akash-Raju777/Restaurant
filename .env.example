# ====================================================================
# The Ember - Master Environment Template
# ====================================================================
# Instructions:
# 1. Copy this file to '.env' in your local development environment:
#      cp .env.example .env
# 2. Fill in your actual local or staging secrets in the '.env' file.
# 3. Never commit '.env' to version control (protected by .gitignore).
# ====================================================================

# ----------------------------------------------------
# 1. Spring Boot Backend Configuration
# ----------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ----------------------------------------------------
# 2. Supabase PostgreSQL Connection
# ----------------------------------------------------
DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=REPLACE_WITH_YOUR_LOCAL_SECRET

# HikariCP Connection Pooling
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ----------------------------------------------------
# 3. Security & JWT Credentials
# (Generate a strong 256-bit or 512-bit Base64-encoded string)
# ----------------------------------------------------
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_BASE64_SECRET
JWT_EXPIRATION_MS=86400000

# Initial Administrator Credentials (Bootstrap)
EMBER_ADMIN_EMAIL=admin@theember.com
EMBER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# Demo Customer Credentials (Optional)
EMBER_CUSTOMER_EMAIL=customer@theember.com
EMBER_CUSTOMER_PASSWORD=REPLACE_WITH_A_CUSTOMER_PASSWORD

# ----------------------------------------------------
# 4. Payment Gateway (Razorpay - Sandbox / Production)
# ----------------------------------------------------
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# ----------------------------------------------------
# 5. Frontend Public Configuration (Next.js)
# NOTE: Only non-sensitive NEXT_PUBLIC_* variables belong here
# ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
